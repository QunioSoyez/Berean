cuatro reyes"]}],"13":[{"k":"s2","t":["Abram acude al rescate"]}],"17":[{"k":"s1","t":["Melquisedec bendice a Abram"]},{"k":"r","t":["Relaciones bíblicas: ",{"t":"Salmos 110:4","ref":"PSA.110.4"},"; ",{"t":"Hebreos 7:1–10","ref":"HEB.7.1-HEB.7.10"}]}],"21":[{"k":"s2","t":["La respuesta al rey de Sodoma"]}]},"15":{"1":[{"k":"s1","t":["Dios promete a Abram un hijo"]},{"k":"r","t":["Relaciones bíblicas: ",{"t":"Romanos 4:1–12","ref":"ROM.4.1-ROM.4.12"},"; ",{"t":"Gálatas 3:6–9","ref":"GAL.3.6-GAL.3.9"},"; ",{"t":"Santiago 2:20–26","ref":"JAS.2.20-JAS.2.26"}]}],"7":[{"k":"s1","t":["La tierra prometida y el pacto con Abram"]},{"k":"r","t":["Relaciones bíblicas: ",{"t":"Nehemías 9:7–8","ref":"NEH.9.7-NEH.9.8"},"; ",{"t":"Gálatas 3:15–18","ref":"GAL.3.15-GAL.3.18"}]}],"12":[{"k":"s2","t":["El futuro de su descendencia"]}],"17":[{"k":"s2","t":["La confirmación del pacto"]}]},"16":{"1":[{"k":"s1","t":["Agar e Ismael"]},{"k":"r","t":["Relación: ",{"t":"Gálatas 4:22–31","ref":"GAL.4.22-GAL.4.31"},"."]}],"7":[{"k":"s2","t":["El encuentro de Agar en el desierto"]}],"15":[{"k":"s2","t":["El nacimiento de Ismael"]}]},"17":{"1":[{"k":"s1","t":["El pacto con Abraham y la promesa de Isaac"]},{"k":"r","t":["Relación: ",{"t":"Romanos 4:16–22","ref":"ROM.4.16-ROM.4.22"},"."]}],"9":[{"k":"s2","t":["La circuncisión, señal del pacto"]},{"k":"r","t":["Relaciones: ",{"t":"Romanos 4:9–12","ref":"ROM.4.9-ROM.4.12"},"; ",{"t":"Hechos 15:1–11","ref":"ACT.15.1-ACT.15.11"},"."]}],"15":[{"k":"s1","t":["La promesa del nacimiento de Isaac"]},{"k":"r","t":["Cumplimiento: ",{"t":"Génesis 21:1–7","ref":"GEN.21.1-GEN.21.7"},"."]}],"23":[{"k":"s2","t":["Abraham obedece con toda su casa"]}]},"18":{"1":[{"k":"s1","t":["Los visitantes y la promesa a Sara"]},{"k":"r","t":["Cumplimiento: ",{"t":"Génesis 21:1–7","ref":"GEN.21.1-GEN.21.7"},"."]}],"9":[{"k":"s2","t":["El anuncio del nacimiento de Isaac"]}],"16":[{"k":"s1","t":["La justicia de Dios ante el clamor de Sodoma"]},{"k":"r","t":["Relación: ",{"t":"Ezequ