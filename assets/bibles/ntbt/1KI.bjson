"]}],"30":[{"k":"s1","t":["El altar de Jehová y la respuesta de fuego"]}],"41":[{"k":"s1","t":["Elías ora por lluvia"]}]},"19":{"1":[{"k":"s1","t":["Elías huye a Horeb"]}],"9":[{"k":"s1","t":["El encuentro de Elías con Jehová en Horeb"]}],"19":[{"k":"s1","t":["Llamamiento de Eliseo"]}]},"20":{"1":[{"k":"s1","t":["El sitio de Samaria y las exigencias de Ben-adad"]}],"13":[{"k":"s1","t":["Israel vence al ejército de Aram"]}],"22":[{"k":"s1","t":["Segunda campaña de Aram contra Israel"]}],"31":[{"k":"s1","t":["El pacto de Acab con Ben-adad"]}],"35":[{"k":"s1","t":["Un profeta anuncia el juicio sobre Acab"]}]},"21":{"1":[{"k":"s1","t":["Acab y la viña de Nabot"]}],"8":[{"k":"s1","t":["La conspiración de Jezabel y la muerte de Nabot"]}],"17":[{"k":"s1","t":["El juicio de Jehová sobre Acab y su casa"]}],"27":[{"k":"s1","t":["Acab se humilla y el juicio sobre su casa se aplaza"]}]},"22":{"1":[{"k":"s1","t":["Micaías profetiza la derrota de Acab"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Crónicas 18:1–34","ref":"2CH.18.1-2CH.18.34"}]}],"19":[{"k":"s1","t":["La visión del trono de Jehová y el juicio sobre Acab"]}],"29":[{"k":"s1","t":["La batalla de Ramot de Galaad y la muerte de Acab"]}],"41":[{"k":"s1","t":["Reinado de Josafat"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Crónicas 20:31–37","ref":"2CH.20.31-2CH.20.37"}]}],"51":[{"k":"s1","t":["Reinado de Ocozías de Israel"]}]}}}