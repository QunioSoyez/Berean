sis 48:5–6","ref":"GEN.48.5-GEN.48.6"},"; ",{"t":"Génesis 49:3–4","ref":"GEN.49.3-GEN.49.4"},"."]}],"4":[{"k":"s1","t":["Una familia de Rubén y el destierro"]}],"10":[{"k":"s1","t":["Una guerra en Galaad en tiempos de Saúl"]}],"11":[{"k":"s1","t":["Descendientes de Gad"]}],"18":[{"k":"s1","t":["Victoria de las tribus de Transjordania"]}],"23":[{"k":"s1","t":["La media tribu de Manasés y el destierro"]}]},"6":{"1":[{"k":"s1","t":["Las familias de Leví y la línea sacerdotal"]}],"16":[{"k":"s1","t":["Las ramas de las familias levíticas"]}],"31":[{"k":"s1","t":["Los cantores del santuario y sus familias"]}],"49":[{"k":"s1","t":["Descendientes de Aarón"]}],"54":[{"k":"s1","t":["Las ciudades de los levitas"]},{"k":"r","t":["Texto relacionado: ",{"t":"Josué 21:1–42","ref":"JOS.21.1-JOS.21.42"},"."]}]},"7":{"1":[{"k":"s1","t":["Descendientes de Isacar"]}],"6":[{"k":"s1","t":["Descendientes de Benjamín"]}],"13":[{"k":"s1","t":["Descendientes de Neftalí"]}],"14":[{"k":"s1","t":["Descendientes de Manasés"]}],"20":[{"k":"s1","t":["Descendientes de Efraín"]}],"28":[{"k":"s1","t":["Los asentamientos de los hijos de José"]}],"30":[{"k":"s1","t":["Descendientes de Aser"]}]},"8":{"1":[{"k":"s1","t":["Descendientes de Benjamín"]}],"6":[{"k":"s1","t":["El traslado de una familia de Geba"]}],"8":[{"k":"s1","t":["Una familia benjaminita en Moab"]}],"13":[{"k":"s1","t":["Casas de Benjamín en Ajalón y Jerusalén"]}],"29":[{"k":"s1","t":["La familia de Saúl"]}]},"9":{"1":[{"k":"s1","t":["Los que regresaron de Babilonia"]},{"k":"r","t":["Texto relacionado: ",{"t":"Nehemías 11:1–24","ref":"NEH.11.1-NEH.11.24"},"."]}],"10":[{"k":"s1","t":["Las familias sacerdotales de Jerusalén"]}],"14":[{"k":"s1","t":["Las familias de los levitas"]}],"17":[{"k":"s1","t":["Los encargos de la casa de Dios"]}],"35":[{"k":"s1","t":["Genealogía de Saúl"]}]},"10":{"1":[{"k":"s1","t":["Muerte de Saúl y de sus hijos"]},{"k":"r","t":["Texto relacionado: ",{"t":"1 Samuel 31:1–13","ref":"1SA.31.1-1SA.31.13"},"."]}],"11":[{"k":"s1","t":["La respuesta de Jabes de Galaad"]}],"13":[{"k":"s1","t":["Por qué Saúl perdió el reino"]}]},"11":{"1":[{"k":"s1","t":["David es proclamado rey de Israel"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Samuel 5:1–5","ref":"2SA.5.1-2SA.5.5"},"."]}],"4":[{"k":"s1","t":["David toma la fortaleza de Sion"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Samuel 5:6–10","ref":"2SA.5.6-2SA.5.10"},"."]}],"10":[{"k":"s1","t":["Los valientes de David"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Samuel 23:8–39","ref":"2SA.23.8-2SA.23.39"},"."]}]},"12":{"1":[{"k":"s1","t":["Guerreros que acudieron a David"]}],"8":[{"k":"s1","t":["Los gaditas que se unieron a David"]}],"16":[{"k":"s1","t":["Un compromiso de lealtad a David"]}],"19":[{"k":"s1","t":["Los guerreros de Manasés"]}],"23":[{"k":"s1","t":["Los contingentes que acudieron a Hebrón"]}],"39":[{"k":"s1","t":["Israel celebra en Hebrón"]}]},"13":{"1":[{"k":"s1","t":["David propone trasladar el arca a Jerusalén"]}],"5":[{"k":"s1","t":["David intenta traer el arca"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Samuel 6:1–11","ref":"2SA.6.1-2SA.6.11"},"."]}]},"14":{"1":[{"k":"s1","t":["Huram ayuda a construir la casa de David"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Samuel 5:11–12","ref":"2SA.5.11-2SA.5.12"},"."]}],"3":[{"k":"s1","t":["Hijos de David nacidos en Jerusalén"]},{"k":"r","t":["Textos relacionados: ",{"t":"2 Samuel 5:13–16","ref":"2SA.5.13-2SA.5.16"},"; ",{"t":"1 Crónicas 3:5–9","ref":"1CH.3.5-1CH.3.9"},"."]}],"8":[{"k":"s1","t":["David derrota a los filisteos"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Samuel 5:17–25","ref":"2SA.5.17-2SA.5.25"},"."]}],"13":[{"k":"s1","t":["Segunda victoria sobre los filisteos"]}]},"15":{"1":[{"k":"s1","t":["David organiza el traslado del arca"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Samuel 6:12–23","ref":"2SA.6.12-2SA.6.23"},"."]}],"4":[{"k":"s1","t":["Los levitas convocados para el traslado"]}],"16":[{"k":"s1","t":["Los músicos y guardianes del arca"]}],"25":[{"k":"s1","t":["El arca es llevada a Jerusalén"]}]},"16":{"1":[{"k":"s1","t":["El arca queda instalada en Jerusalén"]}],"7":[{"k":"s1","t":["Un canto de gratitud a Jehová"]},{"k":"r","t":["Textos relacionados: ",{"t":"Salmos 105:1–15","ref":"PSA.105.1-PSA.105.15"},"; ",{"t":"Salmos 96:1–13","ref":"PSA.96.1-PSA.96.13"},"; ",{"t":"Salmos 106:1","ref":"PSA.106.1"},"; ",{"t":"Salmos 106:47–48","ref":"PSA.106.47-PSA.106.48"},"."]}],"23":[{"k":"s1","t":["La adoración al Creador y Rey"]}],"34":[{"k":"s1","t":["Gratitud y petición de salvación"]}],"37":[{"k":"s1","t":["El servicio diario en Jerusalén y Gabaón"]}]},"17":{"1":[{"k":"s1","t":["Pacto de Dios con David"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Samuel 7:1–29","ref":"2SA.7.1-2SA.7.29"},"."]}],"16":[{"k":"s1","t":["David agradece la promesa de Dios"]}]},"18":{"1":[{"k":"s1","t":["David extiende sus dominios"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Samuel 8:1–14","ref":"2SA.8.1-2SA.8.14"},"."]}],"14":[{"k":"s1","t":["Oficiales de David"]},{"k":"r","t":["Textos relacionados: ",{"t":"2 Samuel 8:15–18","ref":"2SA.8.15-2SA.8.18"},"; ",{"t":"2 Samuel 20:23–26","ref":"2SA.20.23-2SA.20.26"},"."]}]},"19":{"1":[{"k":"s1","t":["El agravio a la embajada de David"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Samuel 10:1–5","ref":"2SA.10.1-2SA.10.5"},"."]}],"6":[{"k":"s1","t":["Joab afronta la coalición contra Israel"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Samuel 10:6–14","ref":"2SA.10.6-2SA.10.14"},"."]}],"16":[{"k":"s1","t":["David vence a los refuerzos arameos"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Samuel 10:15–19","ref":"2SA.10.15-2SA.10.19"},"."]}]},"20":{"1":[{"k":"s1","t":["David captura a Rabá"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Samuel 12:26–31","ref":"2SA.12.26-2SA.12.31"},"."]}],"4":[{"k":"s1","t":["Los hombres de David matan a los gigantes"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Samuel 21:18–22","ref":"2SA.21.18-2SA.21.22"},"."]}]},"21":{"1":[{"k":"s1","t":["David censa al pueblo"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Samuel 24:1–9","ref":"2SA.24.1-2SA.24.9"},"."]}],"7":[{"k":"s1","t":["David confiesa su pecado y recibe el juicio"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Samuel 24:10–17","ref":"2SA.24.10-2SA.24.17"},"."]}],"18":[{"k":"s1","t":["David levanta un altar en la era de Ornán"]},{"k":"r","t":["Texto relacionado: ",{"t":"2 Samuel 24:18–25","ref":"2SA.24.18-2SA.24.25"},"."]}],"28":[{"k":"s1","t":["El lugar para el templo"]}]},"22":{"2":[{"k":"s1","t":["Preparativos para el templo"]}],"6":[{"k":"s1","t":["David prepara a Salomón para construir el templo"]}],"17":[{"k":"s1","t":["La colaboración de los jefes de Israel"]}]},"23":{"1":[{"k":"s1","t":["Distribución y deberes de los levitas"]}],"7":[{"k":"s1","t":["Las familias gersonitas"]}],"12":[{"k":"s1","t":["Las familias coatitas"]}],"21":[{"k":"s1","t":["Las familias meraritas"]}],"24":[{"k":"s1","t":["El servicio levítico en la casa de Jehová"]}]},"24":{"1":[{"k":"s1","t":["Los turnos de las familias sacerdotales"]}],"20":[{"k":"s1","t":["Los jefes de las familias levíticas"]}]},"25":{"1":[{"k":"s1","t":["Los músicos y sus turnos de servicio"]}],"9":[{"k":"s1","t":["Las veinticuatro suertes de los músicos"]}]},"26":{"1":[{"k":"s1","t":["Las familias y divisiones de los porteros"]}],"20":[{"k":"s1","t":["Los responsables de los tesoros y de las cosas consagradas"]}],"29":[{"k":"s1","t":["Los levitas en funciones públicas fuera del santuario"]}]},"27":{"1":[{"k":"s1","t":["Las divisiones militares y sus meses de servicio"]}],"16":[{"k":"s1","t":["Los dirigentes de las tribus de Israel"]}],"23":[{"k":"s1","t":["El censo incompleto y la promesa de Dios"]}],"25":[{"k":"s1","t":["Los administradores de los bienes del rey"]}],"32":[{"k":"s1","t":["Los consejeros y colaboradores de la corte"]}]},"28":{"1":[{"k":"s1","t":["David encarga a Salomón la construcción del templo"]}],"11":[{"k":"s1","t":["Los planos y materiales para la casa de Jehová"]}]},"29":{"1":[{"k":"s1","t":["Las ofrendas voluntarias para la construcción"]}],"10":[{"k":"s1","t":["La oración de gratitud y entrega de David"]}],"20":[{"k":"s1","t":["La celebración y la confirmación de Salomón como rey"]}],"26":[{"k":"s1","t":["Muerte de David"]},{"k":"r","t":["Texto relacionado: ",{"t":"1 Reyes 2:10–12","ref":"1KI.2.10-1KI.2.12"},"."]}]}}}