","t":["Misión de los doce discípulos"]},{"k":"r","t":[{"t":"Mateo 10:5–15","ref":"MAT.10.5-MAT.10.15"},"; ",{"t":"Lucas 9:1–6","ref":"LUK.9.1-LUK.9.6"},"."]}],"14":[{"k":"s1","t":["Muerte de Juan el Bautista"]},{"k":"r","t":[{"t":"Mateo 14:1–12","ref":"MAT.14.1-MAT.14.12"},". Reacción de Herodes: ",{"t":"Lucas 9:7–9","ref":"LUK.9.7-LUK.9.9"},"."]}],"17":[{"k":"s2","t":["El encarcelamiento y la muerte de Juan"]}],"30":[{"k":"s1","t":["Alimentación de los cinco mil"]},{"k":"r","t":[{"t":"Mateo 14:13–21","ref":"MAT.14.13-MAT.14.21"},"; ",{"t":"Lucas 9:10–17","ref":"LUK.9.10-LUK.9.17"},"; ",{"t":"Juan 6:1–14","ref":"JHN.6.1-JHN.6.14"},"."]}],"45":[{"k":"s1","t":["Jesús anda sobre el mar"]},{"k":"r","t":[{"t":"Mateo 14:22–33","ref":"MAT.14.22-MAT.14.33"},"; ",{"t":"Juan 6:15–21","ref":"JHN.6.15-JHN.6.21"},"."]}],"53":[{"k":"s1","t":["Jesús sana a los enfermos en Genesaret"]},{"k":"r","t":[{"t":"Mateo 14:34–36","ref":"MAT.14.34-MAT.14.36"},"."]}]},"7":{"1":[{"k":"s1","t":["Lo que contamina al hombre"]},{"k":"r","t":[{"t":"Mateo 15:1–20","ref":"MAT.15.1-MAT.15.20"},"."]}],"14":[{"k":"s2","t":["La contaminación que procede del corazón"]}],"17":[{"k":"s2","t":["Jesús explica la enseñanza a sus discípulos"]}],"24":[{"k":"s1","t":["La fe de la mujer sirofenicia"]},{"k":"r","t":[{"t":"Mateo 15:21–28","ref":"MAT.15.21-MAT.15.28"},"."]}],"31":[{"k":"s1","t":["Jesús sana a un hombre sordo con dificultad para hablar"]},{"k":"r","t":["Resumen de sanidades relacionado: ",{"t":"Mateo 15:29–31","ref":"MAT.15.29-MAT.15.31"},"."]}]},"8":{"1":[{"k":"s1","t":["Alimentación de los cuatro mil"]},{"k":"r","t":[{"t":"Mateo 15:32–39","ref":"MAT.15.32-MAT.15.39"},"."]}],"11":[{"k":"s1","t":["La demanda de una señal"]},{"k":"r","t":[{"t":"Mateo 16:1–4","ref":"MAT.16.1-MAT.16.4"},". Enseñanza relacionada sobre discernir el tiempo: ",{"t":"Lucas 12:54–56","ref":"LUK.12.54-LUK.12.56"},"."]}],"14":[{"k":"s1","t":["La levadura de los fariseos y de Herodes"]},{"k":"r","t":[{"t":"Mateo 16:5–12","ref":"