","t":["Mensaje con motivo de la sequía"]}]},"15":{"1":[{"k":"s1","t":["La implacable ira de Dios contra Judá"]}],"15":[{"k":"s1","t":["Jehová reanima a Jeremías"]}]},"16":{"1":[{"k":"s1","t":["Juicio de Jehová contra Judá"]}]},"17":{"1":[{"k":"s1","t":["El pecado escrito en el corazón de Judá"]}],"19":[{"k":"s1","t":["Observancia del día de reposo"]}]},"18":{"1":[{"k":"s1","t":["La señal del alfarero y el barro"]}],"18":[{"k":"s1","t":["Conspiración del pueblo y oración de Jeremías"]}]},"19":{"1":[{"k":"s1","t":["La señal de la vasija rota"]}],"14":[{"k":"s1","t":["El anuncio del juicio en el templo"]}]},"20":{"1":[{"k":"s1","t":["Profecía contra Pasur"]}],"7":[{"k":"s1","t":["Lamento de Jeremías"]}],"14":[{"k":"s1","t":["El dolor de haber nacido"]}]},"21":{"1":[{"k":"s1","t":["Jerusalén será destruida"]}],"8":[{"k":"s1","t":["La salida para conservar la vida"]}],"11":[{"k":"s1","t":["El deber de justicia de la casa de David"]}]},"22":{"1":[{"k":"s1","t":["Profecías contra los reyes de Judá"]}],"10":[{"k":"s1","t":["El exilio sin regreso de Salum"]}],"13":[{"k":"s1","t":["La injusticia del rey Joacim"]}],"20":[{"k":"s1","t":["El fracaso de los apoyos de Jerusalén"]}],"24":[{"k":"s1","t":["Conías y el futuro de su dinastía"]}]},"23":{"1":[{"k":"s1","t":["Regreso del remanente"]}],"5":[{"k":"s1","t":["El Rey justo prometido a David"]}],"9":[{"k":"s1","t":["Denunciación de los falsos profetas"]}],"16":[{"k":"s1","t":["Los mensajes de falsa paz"]}],"23":[{"k":"s1","t":["La palabra de Dios y los sueños falsos"]}],"33":[{"k":"s1","t":["El abuso de «oráculo de Jehová»"]}]},"24":{"1":[{"k":"s1","t":["La señal de los higos buenos y malos"]}],"5":[{"k":"s1","t":["El favor de Dios hacia los desterrados"]}],"8":[{"k":"s1","t":["La advertencia a Sedequías y a los que quedaron"]}]},"25":{"1":[{"k":"s1","t":["Setenta años de desolación"]}],"8":[{"k":"s1","t":["El juicio anunciado mediante Babilonia"]}],"12":[{"k":"s1","t":["Babilonia responderá por su culpa"]}],"15":[{"k":"s1","t":["La copa de ira para las naciones"]}],"30":[{"k":"s1","t":["El juicio de Jehová alcanza a las naciones"]}],"34":[{"k":"s1","t":["El lamento de los dirigentes del rebaño"]}]},"26":{"1":[{"k":"s1","t":["Jeremías es amenazado de muerte"]}],"8":[{"k":"s1","t":["El arresto de Jeremías"]}],"10":[{"k":"s1","t":["El proceso ante los jefes de Judá"]}],"12":[{"k":"s1","t":["La defensa y el llamado de Jeremías"]}],"17":[{"k":"s1","t":["El precedente de Miqueas"]}],"20":[{"k":"s1","t":["La persecución y muerte de Urías"]}],"24":[{"k":"s1","t":["Ahicam protege a Jeremías"]}]},"27":{"1":[{"k":"s1","t":["La señal de los yugos"]}],"9":[{"k":"s1","t":["Las promesas falsas de independencia"]}],"12":[{"k":"s1","t":["La exhortación a Sedequías"]}],"16":[{"k":"s1","t":["Los utensilios del templo y la promesa de regreso"]}],"19":[{"k":"s1","t":["El destino de los utensilios que quedan"]}]},"28":{"1":[{"k":"s1","t":["Falsa profecía de Hananías"]}],"5":[{"k":"s1","t":["La respuesta de Jeremías"]}],"10":[{"k":"s1","t":["Hananías rompe el yugo"]}],"12":[{"k":"s1","t":["Jehová reafirma su palabra"]}],"15":[{"k":"s1","t":["La sentencia contra Hananías"]}]},"29":{"1":[{"k":"s1","t":["Carta de Jeremías a los cautivos"]}],"5":[{"k":"s1","t":["La vida fiel durante el destierro"]}],"8":[{"k":"s1","t":["El discernimiento y la esperanza del regreso"]}],"16":[{"k":"s1","t":["Advertencia sobre los que quedaron en Jerusalén"]}],"21":[{"k":"s1","t":["La sentencia contra Acab y Sedequías"]}],"24":[{"k":"s1","t":["Las cartas de Semaías"]}],"30":[{"k":"s1","t":["La respuesta de Jehová sobre Semaías"]}]},"30":{"1":[{"k":"s1","t":["Dios promete que los cautivos volverán"]}],"5":[{"k":"s1","t":["La angustia de Jacob y su liberación"]}],"12":[{"k":"s1","t":["La herida de Sion y la curación prometida"]}],"18":[{"k":"s1","t":["La comunidad restaurada ante Jehová"]}],"23":[{"k":"s1","t":["La tempestad de Jehová y sus propósitos"]}]},"31":{"1":[{"k":"s1","t":["El amor fiel de Jehová y el regreso de Israel"]}],"7":[{"k":"s1","t":["Jehová reúne y rescata a su pueblo"]}],"15":[{"k":"s1","t":["El llanto de Raquel y la esperanza del regreso"]}],"18":[{"k":"s1","t":["El arrepentimiento de Efraín y la compasión de Jehová"]}],"21":[{"k":"s1","t":["La invitación de Jehová a volver"]}],"23":[{"k":"s1","t":["La restauración de Judá y el descanso del pueblo"]}],"27":[{"k":"s1","t":["El nuevo pacto"]}],"35":[{"k":"s1","t":["La fidelidad de Jehová a Israel"]}],"38":[{"k":"s1","t":["Jerusalén será reconstruida para Jehová"]}]},"32":{"1":[{"k":"s1","t":["Jeremías compra la heredad de Hanameel"]}],"16":[{"k":"s1","t":["La oración de Jeremías después de la compra"]}],"26":[{"k":"s1","t":["La respuesta de Jehová a Jeremías"]}],"36":[{"k":"s1","t":["Jehová promete reunir y renovar a su pueblo"]}],"42":[{"k":"s1","t":["Volverán a comprarse campos en Judá"]}]},"33":{"1":[{"k":"s1","t":["Restauración de la prosperidad de Jerusalén"]}],"6":[{"k":"s1","t":["Sanidad y perdón para el pueblo restaurado"]}],"10":[{"k":"s1","t":["La alegría y la gratitud volverán a Jerusalén"]}],"12":[{"k":"s1","t":["Los rebaños volverán a las ciudades de Judá"]}],"14":[{"k":"s1","t":["La buena promesa a David y a los sacerdotes"]}],"19":[{"k":"s1","t":["La firmeza de las promesas de Jehová"]}],"23":[{"k":"s1","t":["Jehová confirma su compasión por su pueblo"]}]},"34":{"1":[{"k":"s1","t":["Jeremías amonesta a Sedequías"]}],"8":[{"k":"s1","t":["Violación del pacto de libertar a los siervos hebreos"]}],"12":[{"k":"s1","t":["El pacto del éxodo y la libertad quebrantada"]}],"17":[{"k":"s1","t":["La libertad rechazada y el juicio anunciado"]}],"21":[{"k":"s1","t":["El regreso del ejército babilónico"]}]},"35":{"1":[{"k":"s1","t":["Obediencia de los recabitas"]}],"6":[{"k":"s1","t":["El compromiso recibido de Jonadab"]}],"11":[{"k":"s1","t":["La guerra los llevó a refugiarse en Jerusalén"]}],"12":[{"k":"s1","t":["La lección de los recabitas para Judá"]}],"17":[{"k":"s1","t":["El juicio anunciado contra la desobediencia de Judá"]}],"18":[{"k":"s1","t":["La promesa de Jehová para los recabitas"]}]},"36":{"1":[{"k":"s1","t":["El rey quema el rollo"]}],"9":[{"k":"s1","t":["El rollo es leído durante el ayuno"]}],"12":[{"k":"s1","t":["Los jefes escuchan el informe y piden el rollo"]}],"21":[{"k":"s1","t":["La lectura del rollo ante Joacim"]}],"27":[{"k":"s1","t":["Jehová ordena escribir de nuevo sus palabras"]}],"30":[{"k":"s1","t":["La sentencia sobre Joacim y su casa"]}]},"37":{"1":[{"k":"s1","t":["Encarcelamiento de Jeremías"]}],"7":[{"k":"s1","t":["La retirada de los caldeos será temporal"]}],"11":[{"k":"s1","t":["La detención de Jeremías en la puerta de Benjamín"]}],"17":[{"k":"s1","t":["La consulta secreta de Sedequías"]}]},"38":{"1":[{"k":"s1","t":["Jeremías en la cisterna"]}],"7":[{"k":"s1","t":["Ebed-melec interviene por Jeremías"]}],"14":[{"k":"s1","t":["Sedequías consulta secretamente a Jeremías"]}],"17":[{"k":"s1","t":["La condición ofrecida a Sedequías"]}],"24":[{"k":"s1","t":["La conversación queda reservada"]}]},"39":{"1":[{"k":"s1","t":["Caída de Jerusalén"]},{"k":"r","t":["Textos relacionados: ",{"t":"2 Reyes 24:20–25:21","ref":"2KI.24.20"},"; ",{"t":"2 Crónicas 36:17–21","ref":"2CH.36.17-2CH.36.21"},"; ",{"t":"Jeremías 52:3–30","ref":"JER.52.3-JER.52.30"}]}],"4":[{"k":"s1","t":["La captura y el castigo de Sedequías"]}],"8":[{"k":"s1","t":["Jerusalén devastada y el pueblo desterrado"]}],"11":[{"k":"s1","t":["Nabucodonosor cuida de Jeremías"]}],"15":[{"k":"s1","t":["Dios promete librar a Ebed-melec"]}]},"40":{"1":[{"k":"s1","t":["Jeremías y el remanente con Gedalías"]}],"7":[{"k":"s1","t":["La reorganización del pueblo en Judá"]}],"11":[{"k":"s1","t":["El regreso de los refugiados"]}],"13":[{"k":"s1","t":["Conspiración de Ismael contra Gedalías"]}]},"41":{"1":[{"k":"s1","t":["El asesinato de Gedalías"]}],"4":[{"k":"s1","t":["La matanza de los peregrinos"]}],"11":[{"k":"s1","t":["El rescate de los cautivos"]}],"16":[{"k":"s1","t":["Los sobrevivientes toman rumbo a Egipto"]}]},